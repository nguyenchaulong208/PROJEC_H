<Page
    x:Class="MyShop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24">
            <TextBlock Text="Tổng quan hệ thống" FontSize="28" FontWeight="Bold" />

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Tổng sản phẩm" FontSize="14" Opacity="0.6" />
                        <TextBlock x:Name="TotalProductsText" FontSize="32" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Đơn hôm nay" FontSize="14" Opacity="0.6" />
                        <TextBlock x:Name="TodayOrdersText" FontSize="32" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Doanh thu hôm nay" FontSize="14" Opacity="0.6" />
                        <TextBlock x:Name="TodayRevenueText" FontSize="32" FontWeight="Bold"
                                   Foreground="{ThemeResource SystemAccentColor}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Sắp hết hàng" FontSize="14" Opacity="0.6" />
                        <TextBlock x:Name="LowStockText" FontSize="32" FontWeight="Bold"
                                   Foreground="OrangeRed" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Top 5 sản phẩm bán chạy" FontSize="18" FontWeight="SemiBold" />
                        <ListView x:Name="TopSellingList" BorderThickness="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Top 5 sắp hết hàng" FontSize="18" FontWeight="SemiBold" />
                        <ListView x:Name="LowStockList" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="3 đơn hàng gần nhất" FontSize="18" FontWeight="SemiBold" />
                    <ListView x:Name="RecentOrdersList" BorderThickness="0" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Biểu đồ doanh thu theo ngày (tháng hiện tại)" FontSize="18" FontWeight="SemiBold" />
                    <Border x:Name="ChartContainer" Height="300" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
