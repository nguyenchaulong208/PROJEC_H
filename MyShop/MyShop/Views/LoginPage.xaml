<Page
    x:Class="MyShop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
            <StackPanel Spacing="16" Padding="32">
                <TextBlock Text="MyShop 2025" FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" />

                <TextBlock x:Name="VersionText" FontSize="14"
                           HorizontalAlignment="Center" Opacity="0.6" />

                <TextBox x:Name="UsernameBox" PlaceholderText="Tên đăng nhập"
                         Header="Tài khoản" />
                <PasswordBox x:Name="PasswordBox" PlaceholderText="Mật khẩu"
                             Header="Mật khẩu" />
                <CheckBox x:Name="RememberCheck" Content="Ghi nhớ đăng nhập" />

                <TextBlock x:Name="ErrorText" Foreground="Red" Visibility="Collapsed" />

                <Button x:Name="LoginButton" Content="Đăng nhập"
                        HorizontalAlignment="Stretch" Height="40"
                        Click="OnLoginClick"
                        Style="{StaticResource AccentButtonStyle}" />

                <HyperlinkButton Content="Cấu hình kết nối server..."
                                 HorizontalAlignment="Center"
                                 Click="OnConfigClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
