<Page
    x:Class="MyShop.Views.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="450" Spacing="12" Padding="32">
            <TextBlock Text="Cấu hình kết nối Server" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <TextBox x:Name="ServerBox" PlaceholderText="localhost" Header="Địa chỉ server" />
            <TextBox x:Name="PortBox" PlaceholderText="5432" Header="Cổng" />
            <TextBox x:Name="DbBox" PlaceholderText="myshop" Header="Tên database" />
            <TextBox x:Name="UserBox" PlaceholderText="postgres" Header="Tài khoản" />
            <PasswordBox x:Name="PassBox" PlaceholderText="Mật khẩu" Header="Mật khẩu" />

            <TextBlock x:Name="StatusText" Foreground="Green" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <Button Content="Kiểm tra kết nối" Click="OnTestClick" />
                <Button Content="Lưu cấu hình" Click="OnSaveClick"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <HyperlinkButton Content="← Quay lại đăng nhập"
                             HorizontalAlignment="Center"
                             Click="OnBackClick" />
        </StackPanel>
    </Grid>
</Page>
