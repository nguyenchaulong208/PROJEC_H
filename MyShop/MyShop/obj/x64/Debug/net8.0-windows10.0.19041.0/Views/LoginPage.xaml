<Page
    x:Class="MyShop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
            <StackPanel Spacing="16" Padding="32">
                <TextBlock Text="MyShop 2025" FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" />

                <TextBlock x:ConnectionId='2' x:Name="VersionText" FontSize="14"
                           HorizontalAlignment="Center" Opacity="0.6" />

                <TextBox x:ConnectionId='3' x:Name="UsernameBox" PlaceholderText="Tên đăng nhập"
                         Header="Tài khoản" />
                <PasswordBox x:ConnectionId='4' x:Name="PasswordBox" PlaceholderText="Mật khẩu"
                             Header="Mật khẩu" />
                <CheckBox x:ConnectionId='5' x:Name="RememberCheck" Content="Ghi nhớ đăng nhập" />

                <TextBlock x:ConnectionId='6' x:Name="ErrorText" Foreground="Red" Visibility="Collapsed" />

                <Button x:ConnectionId='7' x:Name="LoginButton" Content="Đăng nhập"
                        HorizontalAlignment="Stretch" Height="40"
                                            
                        Style="{StaticResource AccentButtonStyle}" />

                <HyperlinkButton x:ConnectionId='8' Content="Cấu hình kết nối server..."
                                 HorizontalAlignment="Center"
                                                       />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

