<Page
    x:Class="MyShop.Views.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*">
        <TextBlock Text="Báo cáo thống kê" FontSize="28" FontWeight="Bold" />

        <StackPanel Grid.Row="1" Spacing="12" Margin="0,12">
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                <ComboBox x:ConnectionId='4' x:Name="ReportTypeCombo" PlaceholderText="Loại báo cáo" Header="Báo cáo" />
                <ComboBox x:ConnectionId='5' x:Name="ChartTypeCombo" Grid.Column="1" PlaceholderText="Biểu đồ" Header="Biểu đồ" />
                <Button x:ConnectionId='6' Grid.Column="2" Content="Xem báo cáo"                     
                        Margin="0,24,0,0" Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefault}"
                CornerRadius="8" Padding="16" Margin="0,8">
            <Grid RowDefinitions="Auto,*">
                <TextBlock x:ConnectionId='2' x:Name="ReportTitleText" FontSize="20" FontWeight="SemiBold" />
                <Border x:ConnectionId='3' x:Name="ChartContainer" Grid.Row="1" Height="450" Margin="0,16,0,0" />
            </Grid>
        </Border>
    </Grid>
</Page>

