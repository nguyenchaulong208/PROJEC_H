<Page
    x:Class="MyShop.Views.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="450" Spacing="12" Padding="32">
            <TextBlock Text="Cấu hình kết nối Server" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <TextBox x:ConnectionId='2' x:Name="ServerBox" PlaceholderText="localhost" Header="Địa chỉ server" />
            <TextBox x:ConnectionId='3' x:Name="PortBox" PlaceholderText="5432" Header="Cổng" />
            <TextBox x:ConnectionId='4' x:Name="DbBox" PlaceholderText="myshop" Header="Tên database" />
            <TextBox x:ConnectionId='5' x:Name="UserBox" PlaceholderText="postgres" Header="Tài khoản" />
            <PasswordBox x:ConnectionId='6' x:Name="PassBox" PlaceholderText="Mật khẩu" Header="Mật khẩu" />

            <TextBlock x:ConnectionId='7' x:Name="StatusText" Foreground="Green" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <Button x:ConnectionId='9' Content="Kiểm tra kết nối"                     />
                <Button x:ConnectionId='10' Content="Lưu cấu hình"                    
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <HyperlinkButton x:ConnectionId='8' Content="← Quay lại đăng nhập"
                             HorizontalAlignment="Center"
                                                 />
        </StackPanel>
    </Grid>
</Page>

