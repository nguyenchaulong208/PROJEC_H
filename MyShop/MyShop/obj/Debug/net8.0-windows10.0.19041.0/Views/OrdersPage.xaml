<Page
    x:Class="MyShop.Views.OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:MyShop.Converters">

    <Page.Resources>
        <converters:PriceFormatConverter x:Key="PriceConverter" />
        <converters:DateTimeFormatConverter x:Key="DateTimeConverter" />
        <converters:OrderIdFormatConverter x:Key="OrderIdConverter" />
    </Page.Resources>

    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Text="Quản lý đơn hàng" FontSize="28" FontWeight="Bold" />

        <StackPanel Grid.Row="1" Spacing="12" Margin="0,12">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <DatePicker x:ConnectionId='11' x:Name="FromDate" Header="Từ ngày" />
                <DatePicker x:ConnectionId='12' x:Name="ToDate" Grid.Column="1" Header="Đến ngày" />
                <ComboBox x:ConnectionId='13' x:Name="StatusFilter" Grid.Column="2" PlaceholderText="Trạng thái"
                          MinWidth="140" Header="Trạng thái" />
                <Button x:ConnectionId='14' Grid.Column="4" Content="Tìm kiếm"                       Margin="0,24,0,0" />
            </Grid>
            <Button x:ConnectionId='10' Content="+ Tạo đơn hàng"                       Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Left" />
        </StackPanel>

        <ListView x:ConnectionId='2' Grid.Row="2" x:Name="OrderList" Margin="0,8"
                  SelectionMode="Single" BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,2" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefault}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="16">
                            <TextBlock Text="{Binding OrderId, Converter={StaticResource OrderIdConverter}}" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CreatedTime, Converter={StaticResource DateTimeConverter}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding FinalPrice, Converter={StaticResource PriceConverter}}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemAccentColor}" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:ConnectionId='7' Content="Chi tiết"                      Tag="{Binding OrderId}" />
                                <Button x:ConnectionId='8' Content="Sửa"                     Tag="{Binding OrderId}" />
                                <Button x:ConnectionId='9' Content="Xóa"                       Tag="{Binding OrderId}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8">
            <Button x:ConnectionId='3' Content="‹"                    />
            <TextBlock x:ConnectionId='4' x:Name="PageInfoText" VerticalAlignment="Center" Margin="8,0" />
            <Button x:ConnectionId='5' Content="›"                    />
        </StackPanel>
    </Grid>
</Page>

