<Window
    x:Class="MyShop2025.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MyShop 2025 - Phần mềm quản lý bán hàng">

    <Grid>
        <Grid x:Name="LoginContainer" Visibility="Visible">
            <Frame x:Name="LoginFrame"/>
        </Grid>

        <Grid x:Name="MainContainer" Visibility="Collapsed">
            <NavigationView x:Name="MainNavigation"
                            PaneDisplayMode="Left"
                            IsBackButtonVisible="Collapsed"
                            ItemInvoked="MainNavigation_ItemInvoked"
                            Loaded="MainNavigation_Loaded">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NavDashboard" Tag="Dashboard" Content="Tổng quan">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Home"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavProducts" Tag="Products" Content="Sản phẩm">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Shop"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavOrders" Tag="Orders" Content="Đơn hàng">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Document"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavReport" Tag="Report" Content="Báo cáo">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="ReportDocument"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem x:Name="NavSettings" Tag="Settings" Content="Cấu hình">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Setting"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
                <Frame x:Name="ContentFrame"/>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
