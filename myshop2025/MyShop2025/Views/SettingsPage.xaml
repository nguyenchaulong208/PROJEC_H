<Page
    x:Class="MyShop2025.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="16" MaxWidth="600">
            <TextBlock Text="Cấu hình chương trình" FontSize="28" FontWeight="Bold"/>

            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefault}"
                    Padding="24" BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="Hiển thị" FontSize="20" FontWeight="SemiBold"/>

                    <ComboBox x:Name="PageSizeCombo" Header="Số sản phẩm mỗi trang"
                              SelectionChanged="PageSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="20"/>
                    </ComboBox>

                    <Border Height="1" Background="{ThemeResource ControlStrokeColorDefault}"/>

                    <TextBlock Text="Tính năng" FontSize="20" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="AutoSaveToggle" Header="Tự động lưu"
                                  OnContent="Bật" OffContent="Tắt"/>

                    <Border Height="1" Background="{ThemeResource ControlStrokeColorDefault}"/>

                    <TextBlock Text="Thông tin" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Text="MyShop 2025 v1.0.0"/>
                    <TextBlock Text="Phần mềm quản lý bán hàng cho chủ cửa hàng nhỏ"
                               Foreground="{ThemeResource TextFillColorSecondary}"/>
                </StackPanel>
            </Border>

            <Button x:Name="SaveButton" Content="Lưu cấu hình"
                    HorizontalAlignment="Stretch" Height="44"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveButton_Click"/>

            <TextBlock x:Name="StatusText" Foreground="{ThemeResource SystemSuccessColor}"
                       HorizontalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>
