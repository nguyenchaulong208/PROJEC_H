<Page
    x:Class="MyShop2025.Views.OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12">
            <TextBlock Text="Quản lý đơn hàng" FontSize="28" FontWeight="Bold"/>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DatePicker x:Name="DateFromPicker" Grid.Column="0" Header="Từ ngày"/>
                <DatePicker x:Name="DateToPicker" Grid.Column="1" Header="Đến ngày"/>
                <Button Grid.Column="2" Content="Tìm" Margin="0,24,0,0"
                        Height="36" Click="SearchButton_Click"/>
                <Button Grid.Column="4" Content="+ Tạo đơn hàng" Margin="0,24,0,0"
                        Height="36" Click="CreateOrderButton_Click"/>
            </Grid>
        </StackPanel>

        <ListView x:Name="OrderList" Grid.Row="1" Margin="0,8,0,0"
                  SelectionChanged="OrderList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12" Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding orderId}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{Binding createdTime}"/>
                        <TextBlock Grid.Column="2" Text="{Binding finalPrice}"/>
                        <TextBlock Grid.Column="3" Text="{Binding status}"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                            <Button Content="Chi tiết" Click="DetailButton_Click"/>
                            <Button Content="Xóa" Click="DeleteOrderButton_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Spacing="8" Margin="0,8">
            <Button x:Name="PrevButton" Content="Trước" Click="PrevButton_Click"/>
            <TextBlock x:Name="PageText" VerticalAlignment="Center"/>
            <Button x:Name="NextButton" Content="Sau" Click="NextButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
