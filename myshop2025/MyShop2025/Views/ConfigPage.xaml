<Page
    x:Class="MyShop2025.Views.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
        <Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefault}"
                Padding="32" BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
            <StackPanel Spacing="16">
                <TextBlock Text="Cấu hình Server" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Nhập địa chỉ máy chủ database" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondary}"/>

                <TextBox x:Name="ServerAddressBox" Header="Địa chỉ server" PlaceholderText="localhost"/>
                <TextBox x:Name="PortBox" Header="Cổng kết nối" PlaceholderText="3306" Text="3306"/>
                <TextBox x:Name="DbNameBox" Header="Tên database" PlaceholderText="myshop"/>
                <TextBox x:Name="DbUserBox" Header="Tên đăng nhập" PlaceholderText="root"/>
                <PasswordBox x:Name="DbPassBox" Header="Mật khẩu"/>

                <Border Height="1" Background="{ThemeResource ControlStrokeColorDefault}" Margin="0,8"/>

                <Button x:Name="TestButton" Content="Kiểm tra kết nối"
                        HorizontalAlignment="Stretch" Height="40" Click="TestButton_Click"/>
                <Button x:Name="SaveButton" Content="Lưu cấu hình"
                        HorizontalAlignment="Stretch" Height="40"
                        Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click"/>

                <TextBlock x:Name="StatusTextBlock" HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemSuccessColor}" Visibility="Collapsed"/>
                <HyperlinkButton Content="Quay lại đăng nhập" Click="BackButton_Click"
                                 HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
